<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
      <!-- Roslyn, for the architecture tests that parse source rather than inspect loaded types. -->
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
      <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="xunit" />
      <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\api\api.csproj" />
      <ProjectReference Include="..\..\src\features\features.csproj" />
      <ProjectReference Include="..\..\src\infra.persistence.postgre\infra.persistence.postgre.csproj" />
      <!--
        F00's seeder. Referenced here rather than given a tools.seed.tests project of its own:
        conventions §6 names two test projects, and a third is a change to the testing convention
        rather than to this feature. It is also what lets one test assert that the seed's copy of
        F03's attendance-code normaliser agrees with the original, since this assembly is the only
        one that can see both.
      -->
      <ProjectReference Include="..\..\src\tools.seed\tools.seed.csproj" />
    </ItemGroup>

</Project>
